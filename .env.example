# Cloudflare Access JWT origin verification (REQUIRED before deploying live).
# Must match the Cloudflare Zero Trust > Access > Applications configuration.
# Team URL: https://YOUR-TEAM.cloudflareaccess.com ; AUD: Application Audience Tag.
# Operator emails are Access-authenticated identities allowed to sync agent registry.
# An empty operator list permits signed viewer access while denying operator actions.
# Missing team domain or audience FAILS CLOSED for all operational APIs in live mode.
FRIDAY_ACCESS_TEAM_DOMAIN=
FRIDAY_ACCESS_AUD=
FRIDAY_ACCESS_OPERATOR_EMAILS=

# Friday public host port.
FRIDAY_UI_PORT=3010
TZ=America/Chicago

# Server-side local repository registry; checkout roots require explicit registration.
FRIDAY_REPOSITORY_REGISTRY_PATH=./repositories.json

# Safe default. Set live only when intentionally enabling read-only adapters.
FRIDAY_MODE=mock

# Optional local Docker inventory for the controller host. Keep disabled by default.
FRIDAY_DOCKER_ENABLED=false
FRIDAY_DOCKER_HOST_NAME=VM 102

# Proxmox read-only API token configuration. The nic1 management address has not
# been verified live; this URL remains the explicitly labeled vmbr0 rollback path.
FRIDAY_PROXMOX_ENABLED=false
FRIDAY_PROXMOX_URL=https://192.168.1.211:8006
FRIDAY_PROXMOX_TOKEN_ID=
FRIDAY_PROXMOX_TOKEN_SECRET=
# Set true only while bootstrapping against a trusted self-signed Proxmox certificate.
FRIDAY_PROXMOX_INSECURE=false

# VM100 read-only Docker observer. Token is server-side only.
FRIDAY_VM100_OBSERVER_ENABLED=false
FRIDAY_VM100_OBSERVER_URL=http://10.1.10.10:3199
FRIDAY_VM100_OBSERVER_TOKEN=
FRIDAY_VM100_OBSERVER_HOST_NAME=VM 100

# Durable read-only monitoring and incident history. FRIDAY-owned state only.
FRIDAY_MONITORING_ENABLED=false
FRIDAY_MONITORING_POLL_SECONDS=30
FRIDAY_MONITORING_OFFLINE_GRACE_SECONDS=300
FRIDAY_MONITORING_STATE_PATH=/data/monitoring-state.json
FRIDAY_MONITORING_HISTORY_LIMIT=2000

# Read-only incident diagnostics. Enable only after the expanded VM100 observer is healthy.
FRIDAY_DIAGNOSTICS_ENABLED=false

# Structured approved read-only health checks. Maximum 16; credentials, query strings,
# fragments, and redirects are rejected or not followed. Keep this server-only.
FRIDAY_ENDPOINTS_ENABLED=false
FRIDAY_ENDPOINT_CHECKS_JSON=
# Example (keep on one line in the production .env):
# FRIDAY_ENDPOINT_CHECKS_JSON='[{"id":"site-a-friday","name":"Friday","site":"Site A","url":"https://friday.example.com/healthz","expectedStatuses":[200]},{"id":"site-b-edge","name":"Remote edge","site":"Site B","url":"https://remote.example.com/status","expectedStatuses":[200,204]}]'
# Legacy comma-separated HTTP/HTTPS URLs remain supported as Site A checks.
# Do not set both endpoint variables.
FRIDAY_ENDPOINT_URLS=

# AdGuard Home read-only status and aggregate DNS statistics. Server-side only.
# AdGuard Home has no read-only role: use a dedicated user, never reuse the owner login.
# Friday sends only GET /control/status and GET /control/stats and forwards no client
# addresses or queried domains. Prefer HTTPS; the URL may not embed credentials.
FRIDAY_ADGUARD_ENABLED=false
FRIDAY_ADGUARD_URL=
FRIDAY_ADGUARD_USERNAME=
FRIDAY_ADGUARD_PASSWORD=
FRIDAY_ADGUARD_SITE=Site A

# Friday local Agent Platform Phase 1. Git owns agent definitions; self-hosted Supabase stores runtime registry state.
# All values are server-only. Never expose Supabase service credentials through VITE_* variables.
FRIDAY_AGENT_REGISTRY_ENABLED=false
FRIDAY_SUPABASE_URL=
FRIDAY_SUPABASE_SERVICE_KEY=
# Verified CT108 nic1 endpoint on vmbr1 / VLAN 10.
FRIDAY_AGENT_LOCAL_ROUTER_URL=http://10.1.10.12:11434
FRIDAY_AGENT_LOCAL_ROUTER_MODEL=qwen3:4b-instruct
FRIDAY_AGENT_LOCAL_ROUTER_TIMEOUT_MS=15000
FRIDAY_AGENT_LOCAL_GENERAL_URL=http://10.1.10.12:11434
FRIDAY_AGENT_LOCAL_GENERAL_MODEL=qwen3:4b-instruct
# Agent answers use a larger token budget than the general assistant fallback.
FRIDAY_AGENT_LOCAL_GENERAL_TIMEOUT_MS=90000
FRIDAY_AGENT_LOCAL_CODER_URL=http://10.1.10.12:11434
FRIDAY_AGENT_LOCAL_CODER_MODEL=qwen3:4b-instruct
FRIDAY_AGENT_LOCAL_CODER_TIMEOUT_MS=90000
FRIDAY_AGENT_MODEL_CONTEXT=8192
FRIDAY_AGENT_MODEL_MAX_TOKENS=768

# Friday multi-provider read-only assistant. Keys are server-only; never use VITE_ prefixes.
FRIDAY_AI_ENABLED=false
FRIDAY_AI_PROVIDER_ORDER=groq,gemini,ollama
FRIDAY_CLOUD_AI_TIMEOUT_MS=15000
FRIDAY_LOCAL_AI_TIMEOUT_MS=45000
# Backward-compatible single timeout. Leave blank when using the split budgets above.
FRIDAY_AI_REQUEST_TIMEOUT_MS=

GROQ_API_KEY=
GROQ_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

FRIDAY_LOCAL_AI_ENABLED=false
FRIDAY_LOCAL_AI_URL=http://ollama:11434
FRIDAY_LOCAL_AI_MODEL=qwen3:4b-instruct
FRIDAY_LOCAL_AI_CONTEXT=8192
FRIDAY_LOCAL_AI_MAX_TOKENS=512

# Optional retained legacy cloud adapters. They are used only when explicitly added to FRIDAY_AI_PROVIDER_ORDER.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
