FRIDAY_OBSERVER_BIND_ADDRESS=10.1.10.10
FRIDAY_OBSERVER_PORT=3199
FRIDAY_OBSERVER_TOKEN=
# Host Docker socket group ID; supply `stat -c %g /var/run/docker.sock` on VM100.
# Never assign this privileged group to the public-facing Friday observer.
FRIDAY_DOCKER_SOCKET_GID=
FRIDAY_OBSERVER_HOST_NAME=VM 100
FRIDAY_OBSERVER_ALLOWED_LABEL_KEYS=com.docker.compose.project,com.docker.compose.service
