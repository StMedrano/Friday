# This proxy alone has read-only access to the host Docker socket.
# It listens exclusively on a private shared UNIX socket, never TCP.
FROM node:22.23.2-alpine3.23
WORKDIR /app
ENV NODE_ENV=production HOME=/tmp
RUN apk upgrade --no-cache \
    && rm -rf /usr/local/lib/node_modules /opt/yarn-v1.22.22 \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg \
    && addgroup -S -g 10001 friday \
    && adduser -S -D -H -u 10001 -G friday friday \
    && mkdir -p /proxy \
    && chown 10001:10001 /proxy
COPY --chown=10001:10001 docker-proxy.mjs ./
USER 10001:10001
HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=3 CMD test -S /proxy/docker.sock || exit 1
CMD ["node","docker-proxy.mjs"]
