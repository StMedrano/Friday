# COPY TO PRIVATE VM100 PATH only after staging Access and tunnel are configured.
# Each staging Access application has its OWN AUD (production AUD is not valid).
FRIDAY_STAGE_CF_ACCESS_AUD=
# Absolute VM100 location of a protected token file; never commit the token.
FRIDAY_STAGE_TUNNEL_TOKEN_FILE=/srv/friday-stage-secrets/staging-tunnel.token
